{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "me",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "OWOCC_ME_CACHE",
			"id": "f479050d529a448583a631a02c8efa70"
		}
	]
}